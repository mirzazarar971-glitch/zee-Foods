PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB connection string. MONGO_URI and MONGODB_URI are both accepted.
# Leave empty to use the bundled persistent embedded MongoDB.
# For Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/zeefoods
# For local: mongodb://127.0.0.1:27017/zeefoods
MONGO_URI=

# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

SEED_ON_EMPTY=true

# Optional AI provider (OpenAI-compatible). Leave OPENAI_API_KEY empty to run the built-in FAQ chatbot.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
